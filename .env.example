# Required: Public domain for ingress hostnames
# Must have wildcard DNS configured (*.domain → VM IP)
# Let's Encrypt HTTP-01 validation requires ports 80/443 accessible from internet
# The https://nip.io service can be used here for testing purpose (e.g. https://<PUBLIC_IP>.nip.io)
EXTERNAL_DOMAIN=demo.example.com

# Demo mode: Controls Terraform provider TLS verification during bootstrap
#
# Set to 'true' for initial deployment:
#   - Required before Let's Encrypt issues certificates
#   - Only affects Terraform ↔ Keycloak API communication
#   - User traffic always uses valid HTTPS
#
# Set to 'false' after initial deployment:
#   - Use when re-running Terraform on existing cluster
#   - Let's Encrypt certs will be active by then
DEMO=true

# Required: Keycloak admin credentials for Terraform provider
# These credentials are used for:
# 1. Logging into Keycloak admin console at https://keycloak.<EXTERNAL_DOMAIN>
# 2. Terraform provider authentication for resource management
# SECURITY: Do NOT use default/weak credentials - deployment will fail if not set
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=

# Required: Portal test user credentials
# Used for logging into the portal at https://<EXTERNAL_DOMAIN>
# SECURITY: Change these to secure credentials - deployment will fail if password not set
KEYCLOAK_ADMIN_TEST_USERNAME=testadmin
KEYCLOAK_ADMIN_TEST_PASSWORD=

# Required: Docker registry credentials for private image pulls
# These are only needed once due to Terraform lifecycle.ignore_changes
# To be removed in the future
DOCKER_REGISTRY_USERNAME='myusername'
DOCKER_REGISTRY_PASSWORD=mypassword
DOCKER_REGISTRY_EXTERNAL_USERNAME='myotherusername'
DOCKER_REGISTRY_EXTERNAL_PASSWORD=myotherpassword
